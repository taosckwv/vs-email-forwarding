# ============================================================================
# vs-email-forwarding 环境变量模板
#
# 用法：复制为 .env 后按实际情况填写。.env 已被 .gitignore 忽略，
#       绝对不要提交到版本库。
#   Linux     : cp .env.example .env
#
# 所有可变的连接参数只允许出现在这里，代码侧统一由 vs_email_forwarding.config 读取；
# 任何模块内直接 os.environ[...] 都属于违规。
# ============================================================================

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------

# 运行环境标识：dev / test / prod
APP_ENV=dev

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志输出格式：console（本地可读） / json（容器内采集）
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# HTTP 服务监听
# ---------------------------------------------------------------------------

# 监听地址，容器内通常为 0.0.0.0
HTTP_HOST=0.0.0.0

# 监听端口
HTTP_PORT=8000

# ---------------------------------------------------------------------------
# 数据库（PostgreSQL）
# ---------------------------------------------------------------------------

# SQLAlchemy 异步连接串，格式 postgresql+asyncpg://用户:口令@主机:端口/库名
#
# 主机名取什么，取决于「谁在连」：
#   * 在开发机上跑 `uv run pytest`、本地调试 —— 写 127.0.0.1；
#   * 在容器里（compose.yaml 的 app 服务）—— 不用在这里写：compose 会用下面的
#     POSTGRES_* 拼出宿主名为服务名 postgres 的连接串，**整条覆盖**本值
#     （容器内的 127.0.0.1 指向应用自己，不是数据库）。
# 所以本文件保持「开发机视角」的 127.0.0.1 即可，**不需要维护两份 .env**；
# 但本地开发时**库名要改**，见下面 POSTGRES_DB 前的说明。
# 下面是明显的假值，请勿直接用于任何环境。
DATABASE_URL=postgresql+asyncpg://vs_email_forwarding:change-me@127.0.0.1:5432/vs_email_forwarding

# 下面三个键供 compose.yaml 里的 postgres:17 容器做初始化（initdb）使用，
# 必须与上面 DATABASE_URL 中的用户 / 口令 / 库名**完全一致**，否则应用连不上库。
POSTGRES_USER=vs_email_forwarding

# 数据库口令。**故意没有默认值**：compose.yaml 里用的是
# `${POSTGRES_PASSWORD:?...}`，不填会让 `docker compose up` 直接失败——
# 这是有意的，避免悄悄用弱口令把数据库跑起来。
# 注意：口令中不要出现 $ @ : / 这几个字符，compose 的变量插值与 URL 解析
# 都会在它们上面出错。
POSTGRES_PASSWORD=change-me

# ⚠️ 库名分三套，照抄下面的默认值在本地会连不上：
#   * 本地开发：compose.dev.yaml 只自动创建开发库 vs_email_forwarding_dev，
#     所以本地 .env 要把上面 DATABASE_URL 与这里的 POSTGRES_DB 的库名都改成它，
#     否则应用会连到一个不存在的库；
#   * 集成测试的库名**不用手工定**：夹具每次 pytest 运行自建形如
#     vs_email_forwarding_test_<pid>_<随机 8 位> 的隔离库、跑完即删（口径见
#     tests/integration/README.md「数据库隔离」与 docs/configuration.md）；
#   * 生产：compose.yaml 在容器内用服务名 postgres 与 POSTGRES_DB 重拼
#     DATABASE_URL（覆盖本文件里的值），所以不要把本地开发库名照搬进服务器上的 .env。
POSTGRES_DB=vs_email_forwarding

# ---------------------------------------------------------------------------
# 发件与回复路由
# ---------------------------------------------------------------------------

# 服务对外发信时使用的发件人地址
MAIL_FROM_ADDRESS=noreply@example.com

# 专用回复邮箱：回复将被路由到这里，再由 IMAP 流拉回本服务
REPLY_TO_ADDRESS=reply@example.com

# ---------------------------------------------------------------------------
# SMTP（出站发送）
# ---------------------------------------------------------------------------

# SMTP 服务器地址（假值，实际值由所有者提供）
SMTP_HOST=smtp.example.com

# SMTP 端口：465 是隐式 TLS（SMTPS）口，与下面的 SMTP_TLS_MODE=ssl 配对。
# 默认值以 config.py 为准（详见 docs/configuration.md 的配置项表）。
SMTP_PORT=465

# SMTP 账号（假值，实际值由所有者提供）
SMTP_USERNAME=change-me

# SMTP 口令（假值，绝对不要提交真实口令）
SMTP_PASSWORD=change-me

# SMTP 连接形态：ssl（建连即 TLS，默认）/ plain（全程明文，本地联调）。
# STARTTLS 已移除——连到只接受 STARTTLS 的端口（如 587）会失败。
SMTP_TLS_MODE=ssl

# ---------------------------------------------------------------------------
# IMAP（入站回复拉取）
# ---------------------------------------------------------------------------

# IMAP 服务器地址（假值，实际值由所有者提供）
IMAP_HOST=imap.example.com

# IMAP 端口：993 是隐式 TLS（IMAPS）口，与下面的 IMAP_TLS_MODE=ssl 配对。
# 本地 GreenMail 的明文口是 3143（见文末「本地开发」段）。
IMAP_PORT=993

# IMAP 账号（假值，实际值由所有者提供）
IMAP_USERNAME=change-me

# IMAP 口令（假值，绝对不要提交真实口令）
IMAP_PASSWORD=change-me

# 拉取回复的邮箱文件夹
IMAP_MAILBOX=INBOX

# 被拉取信箱**地址**（不是文件夹）：启动即校验，必须与 REPLY_TO_ADDRESS 相同，
# 为空或不一致都拒绝启动；它**不默认取 IMAP_USERNAME**——登录名不保证是邮箱地址。
IMAP_ADDRESS=reply@example.com

# IMAP 连接形态：ssl（建连即 TLS，默认）/ plain（全程明文，本地联调）。
# STARTTLS 已移除（与 SMTP 侧同构，两处模式互不影响）。
IMAP_TLS_MODE=ssl

# ---------------------------------------------------------------------------
# TLS 校验（SMTP / IMAP 共用）
# ---------------------------------------------------------------------------

# 是否校验证书链与主机名：默认 true。
# 只有网关证书不可信、又暂时拿不到 CA 时才设为 false——连接仍然加密，但启动阶段
# 会记一条结构化告警（tls_verify_disabled），使「校验被关掉」可观察。
TLS_VERIFY=true

# 私有 CA / 自签网关的 PEM 路径；留空 = 运行环境的默认信任库。
# 配置为非空但文件不可读时，服务启动即拒绝。
TLS_CA_BUNDLE=

# --- 本地开发（bash scripts/dev-up.sh 起的 GreenMail）-----------------------
# GreenMail 的 3025 / 3143 是明文端口，本地把两处连接形态改成 plain：
#   SMTP_HOST=127.0.0.1  SMTP_PORT=3025  SMTP_TLS_MODE=plain
#   IMAP_HOST=127.0.0.1  IMAP_PORT=3143  IMAP_TLS_MODE=plain
# GreenMail 的启动参数自带 auth.disabled，账号口令随便填（但要与 IMAP 侧一致）。
# IMAP_ADDRESS 必须与 REPLY_TO_ADDRESS 保持一致（本地两个都保持上面的假值即可）。
# 细节与实测证据见 docs/research/05-dev-and-build-environment.md。

# ---------------------------------------------------------------------------
# 后台任务间隔（秒）
#
# 四条业务流互相独立、并发运行，随 FastAPI lifespan 启停；保留期清理是第 5 条
# 后台任务，与它们同构（独立循环、独立间隔）。间隔必须是配置项，不许硬编码在代码里。
# ---------------------------------------------------------------------------

# 流① 安全审查出站邮件：待审表 -> 邮件表 / 拒审表
POLL_REVIEW_OUTBOUND_SECONDS=10

# 流② 发送邮件：邮件表 -> SMTP 投递
POLL_SEND_SECONDS=10

# 流③ 拉取入站回复：IMAP -> 待审表
POLL_FETCH_INBOUND_SECONDS=10

# 流④ 安全审查回复：待审表 -> 邮件表 / 拒审表
POLL_REVIEW_INBOUND_SECONDS=10

# 流⑤ 保留期清理：按保留期删除邮件表与拒审表中的历史行（回复由外键级联删除）。
# 默认 3600 秒：清理不是时效敏感动作，按小时跑即可，避免与四条业务流争抢数据库。
POLL_CLEANUP_SECONDS=3600

# ---------------------------------------------------------------------------
# 单次外部调用的墙钟上界（秒）
#
# 超过上界按「抛异常」处理，走既定的重试语义（首次 + 3 次重试、15/30/60 秒退避）；
# FR-15 的「3 分钟内完成投递尝试」由这几个上界与退避表共同推出。
# ---------------------------------------------------------------------------

# 单次 SMTP 投递
SMTP_TIMEOUT_SECONDS=10

# 单次 IMAP 拉取
IMAP_TIMEOUT_SECONDS=10

# 单次审查调用
REVIEW_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# 批量与内容上限
# ---------------------------------------------------------------------------

# 每批条数，五条流共用；流③ 用它限制单个 tick 拉取的封数（剩余留到下一个 tick）
BATCH_SIZE=100

# 主题长度上限（**字符**）：API 层校验，超限返回 422 且不落库
MAX_SUBJECT_CHARS=500

# 正文长度上限（**字节**，默认 1048576 = 1 MiB）：API 层校验，超限返回 422 且不落库
MAX_BODY_BYTES=1048576

# 入站回复寄件人地址上限（**字符**，默认 320）：流③ 在入库前截断，不参与 API 校验（不返回 422）
MAX_RECIPIENT_CHARS=320

# ---------------------------------------------------------------------------
# 回复查询分页
# ---------------------------------------------------------------------------

# GET /v1/messages/{id}/replies 每页条数上限（keyset 游标分页，响应带 next_cursor）
REPLIES_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# 部署（只有服务器上的 .env 需要关心）
# ---------------------------------------------------------------------------

# 与公网隔离的服务器上要运行的镜像 tag。镜像由产出侧 `bash deploy/package.sh` 打成 tar，
# 手动带入服务器后 `docker load`（带入与 load 刻意不脚本化，见
# docs/research/01-delivery-and-deploy.md），
# 这里指定具体版本 tag（便于回滚：改成旧 tag 再 `docker compose up -d`）。
# 留空则退回 compose.yaml 里的默认值 vs-email-forwarding:latest。
VS_EMAIL_FORWARDING_IMAGE=vs-email-forwarding:0.1.0
